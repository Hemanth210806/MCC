FLASK_ENV=development
SECRET_KEY=change_me_to_a_secure_random_key
JWT_SECRET_KEY=change_me_to_a_jwt_secret_key
DATABASE_URL=mysql+pymysql://mcc_user:mcc_pass@localhost:3306/mcc_db
UPLOAD_FOLDER=app/static/uploads
MAX_UPLOAD_MB=5
ML_MODEL_PATH=ml/model/mcc_classifier.h5
ML_CONFIDENCE_THRESHOLD=0.6
HOTSPOT_EPS_METERS=200
HOTSPOT_MIN_SAMPLES=5
RECURRING_RADIUS_METERS=50
RECURRING_WINDOW_DAYS=90
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=168

# Kaggle API credentials — DO NOT commit real values; keep only in .env (never in .env.example, README, or source)
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# Chosen real Kaggle dataset IDs for training data (see ml/dataset_sources.md)
KAGGLE_GARBAGE_DATASET=asdasdasasdas/garbage-classification
KAGGLE_POTHOLE_DATASET=atulyakumar98/pothole-detection-dataset
KAGGLE_STREETLIGHT_DATASET=samuelayman/light-poles
KAGGLE_WATER_LEAKAGE_DATASET=tareqalhmiedat/water-pipes-dataset
